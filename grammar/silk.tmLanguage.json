{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Silk",
  "scopeName": "source.silk",
  "fileTypes": ["silk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#lifetimes" },
    { "include": "#numbers" },
    { "include": "#imports" },
    { "include": "#directives" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "comment": "Line comments only; //! documents the module and exactly /// documents the next declaration.",
      "patterns": [
        {
          "name": "comment.line.documentation.module.silk",
          "match": "(//!).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.silk" } }
        },
        {
          "name": "comment.line.documentation.silk",
          "match": "(///)(?!/).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.silk" } }
        },
        {
          "name": "comment.line.double-slash.silk",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.silk" } }
        }
      ]
    },
    "strings": {
      "comment": "Text, raw text (r), and byte (b) literals. Single-quote-width literals stop at a line break; triple-quoted literals span lines.",
      "patterns": [
        {
          "name": "string.quoted.triple.raw.silk",
          "begin": "\\b(r)(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.silk" },
            "2": { "name": "punctuation.definition.string.begin.silk" }
          },
          "end": "\"\"\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.silk" } }
        },
        {
          "name": "string.quoted.double.raw.silk",
          "begin": "\\b(r)(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.silk" },
            "2": { "name": "punctuation.definition.string.begin.silk" }
          },
          "end": "(\")|$",
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.silk" } }
        },
        {
          "name": "string.quoted.triple.bytes.silk",
          "begin": "\\b(b)(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.silk" },
            "2": { "name": "punctuation.definition.string.begin.silk" }
          },
          "end": "\"\"\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.silk" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.double.bytes.silk",
          "begin": "\\b(b)(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.silk" },
            "2": { "name": "punctuation.definition.string.begin.silk" }
          },
          "end": "(\")|$",
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.silk" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.triple.silk",
          "begin": "\"\"\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.silk" } },
          "end": "\"\"\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.silk" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.double.silk",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.silk" } },
          "end": "(\")|$",
          "endCaptures": { "1": { "name": "punctuation.definition.string.end.silk" } },
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.silk",
      "match": "\\\\(?:u\\{[0-9A-Fa-f]*\\}|x[0-9A-Fa-f]{2}|.)"
    },
    "characters": {
      "name": "constant.character.silk",
      "match": "'(?:\\\\(?:u\\{[0-9A-Fa-f]*\\}|x[0-9A-Fa-f]{2}|.)|[^'\\\\\\n])'",
      "captures": { "0": { "patterns": [{ "include": "#escapes" }] } }
    },
    "lifetimes": {
      "comment": "An apostrophe and identifier not closed by another apostrophe, as the lexer decides.",
      "match": "(')([A-Za-z_][A-Za-z0-9_]*+)(?!['\\\\])",
      "captures": {
        "1": { "name": "punctuation.definition.lifetime.silk" },
        "2": { "name": "entity.name.type.lifetime.silk" }
      },
      "name": "storage.modifier.lifetime.silk"
    },
    "numbers": {
      "patterns": [
        {
          "comment": "A duration is a sequence of number-unit components, such as 1h30m or 250ms.",
          "name": "constant.numeric.duration.silk",
          "match": "\\b(?:[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:ms|us|ns|w|d|h|m|s))+\\b"
        },
        { "name": "constant.numeric.hex.silk", "match": "\\b0[xX][0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.octal.silk", "match": "\\b0[oO][0-7_]+\\b" },
        { "name": "constant.numeric.binary.silk", "match": "\\b0[bB][01_]+\\b" },
        {
          "name": "constant.numeric.float.silk",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)\\b"
        },
        { "name": "constant.numeric.integer.silk", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "imports": {
      "match": "\\b(import)[ \\t]+([A-Za-z_][A-Za-z0-9_]*(?:[ \\t]*\\.[ \\t]*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.other.import.silk" },
        "2": {
          "name": "meta.path.import.silk",
          "patterns": [
            { "name": "punctuation.accessor.dot.silk", "match": "\\." }
          ]
        }
      }
    },
    "directives": {
      "comment": "`@name` or `@name(...)` before a declaration or a foreign function type, and the `#Role` marker on a reference type.",
      "patterns": [
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.silk" },
            "2": { "name": "entity.name.function.decorator.silk" }
          }
        },
        {
          "match": "(#)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.role.silk" },
            "2": { "name": "entity.name.type.role.silk" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.silk" },
            "2": { "name": "entity.name.function.silk" }
          }
        },
        {
          "match": "\\b(struct|tuple|enum|union|type|service|interface|role)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.$1.silk" },
            "2": { "name": "entity.name.type.silk" }
          }
        }
      ]
    },
    "keywords": {
      "comment": "The keyword set of the native lexer (compiler/src/lexer/Lexer.silk).",
      "patterns": [
        {
          "name": "keyword.control.silk",
          "match": "\\b(?:if|else|while|for|match|break|continue|return|fail)\\b"
        },
        {
          "name": "storage.type.silk",
          "match": "\\b(?:fn|struct|tuple|enum|union|type|service|interface|role|impl|let|const|param)\\b"
        },
        {
          "name": "storage.modifier.silk",
          "match": "\\b(?:pub|static|extern|export|unsafe|effect|mut|once|move)\\b"
        },
        { "name": "keyword.other.import.silk", "match": "\\b(?:import|as)\\b" },
        { "name": "keyword.other.silk", "match": "\\b(?:run|drop|compileError)\\b" },
        { "name": "constant.language.boolean.silk", "match": "\\b(?:true|false)\\b" },
        { "name": "variable.language.self.silk", "match": "\\bself\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.self.silk", "match": "\\bSelf\\b" },
        {
          "name": "support.type.primitive.silk",
          "match": "\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|bool|char|string|never)\\b"
        },
        { "name": "entity.name.type.silk", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.silk" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.silk", "match": "->|=>" },
        { "name": "keyword.operator.pipeline.silk", "match": "\\|>" },
        { "name": "keyword.operator.range.silk", "match": "\\.\\.\\.?" },
        { "name": "keyword.operator.comparison.silk", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.silk", "match": "&&|\\|\\|" },
        { "name": "keyword.operator.assignment.silk", "match": "=" },
        { "name": "keyword.operator.comparison.silk", "match": "<|>" },
        { "name": "keyword.operator.arithmetic.silk", "match": "[-+*/%]" },
        { "name": "keyword.operator.silk", "match": "[!?&|^~]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.silk", "match": "," },
        { "name": "punctuation.terminator.semicolon.silk", "match": ";" },
        { "name": "punctuation.separator.colon.silk", "match": ":" },
        { "name": "punctuation.accessor.dot.silk", "match": "\\." },
        { "name": "punctuation.brackets.round.silk", "match": "[()]" },
        { "name": "punctuation.brackets.square.silk", "match": "[\\[\\]]" },
        { "name": "punctuation.brackets.curly.silk", "match": "[{}]" }
      ]
    }
  }
}
